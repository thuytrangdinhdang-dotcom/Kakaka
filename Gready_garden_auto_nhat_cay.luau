-- =========================================================
-- AUTO NHẶT CÂY: BẤM E KHI PROMPT NHẶT CÂY XUẤT HIỆN LẦN 2
-- Dành cho game Roblox của bạn
-- =========================================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local TreePromptCount = setmetatable({}, {__mode = "k"})

local function IsTreePrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then
        return false
    end

    -- Prompt phải dùng phím E.
    if prompt.KeyboardKeyCode ~= Enum.KeyCode.E then
        return false
    end

    local parent = prompt.Parent
    local text = string.lower(
        tostring(prompt.ActionText) .. " " ..
        tostring(prompt.ObjectText) .. " " ..
        tostring(parent and parent.Name or "")
    )

    return text:find("cây", 1, true)
        or text:find("tree", 1, true)
        or text:find("nhặt", 1, true)
        or text:find("pick", 1, true)
end

local function AutoPickTree(prompt)
    if not IsTreePrompt(prompt) then
        return
    end

    TreePromptCount[prompt] = (TreePromptCount[prompt] or 0) + 1

    -- Chỉ thực hiện ở lần thứ 2.
    if TreePromptCount[prompt] ~= 2 then
        return
    end

    task.wait(0.05)

    if prompt.Parent and prompt.Enabled then
        -- fireproximityprompt chỉ có trong một số môi trường executor.
        if typeof(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
        end
    end
end

for _, obj in ipairs(workspace:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then
        task.spawn(AutoPickTree, obj)
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        task.spawn(AutoPickTree, obj)
    end
end)

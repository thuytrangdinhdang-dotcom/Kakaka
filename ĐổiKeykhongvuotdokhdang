-- Animation
local function animateIntro(screenGui, loadingCircle, percentLabel, loadingText)
    local startTime = tick()
    local duration = 3.5 -- Tổng thời gian
    
    RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local progress = math.min(elapsed / duration, 1)
        
        -- Xoay vòng tròn
        if loadingCircle then
            loadingCircle.Rotation = progress * 360 * 2.5
        end
        
        -- Cập nhật phần trăm
        if percentLabel then
            local percent = math.floor(progress * 100)
            percentLabel.Text = percent .. "%"
            
            -- Đổi màu theo tiến độ
            if percent < 30 then
                percentLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            elseif percent < 60 then
                percentLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            elseif percent < 90 then
                percentLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
            else
                percentLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            end
        end
        
        -- Đổi text loading
        if loadingText then
            local dots = string.rep(".", math.floor(progress * 12) % 4)
            if progress < 0.3 then
                loadingText.Text = "ĐANG KHỞI TẠO" .. dots
            elseif progress < 0.6 then
                loadingText.Text = "ĐANG LOAD SCRIPT" .. dots
            elseif progress < 0.9 then
                loadingText.Text = "SẮP XONG RỒI" .. dots
            else
                loadingText.Text = "✅ HOÀN TẤT!"
                loadingText.TextColor3 = Color3.fromRGB(100, 255, 100)
            end
        end
        
        -- Khi load xong
        if progress >= 1 then
            task.wait(0.8)
            
            -- Animation fade out
            local fadeStart = tick()
            local fadeDuration = 0.6
            
            RunService.RenderStepped:Connect(function()
                local fadeProgress = (tick() - fadeStart) / fadeDuration
                if fadeProgress >= 1 then
                    screenGui:Destroy()
                    -- Gọi script chính của bạn
                    print("✅ ĐĂNG ĐẸP ZAI CRACK SCRIPT ĐÃ LOAD THÀNH CÔNG!")
                    -- Code của bạn ở đây
                    return
                end
                
                -- Làm mờ dần
                screenGui.BackgroundTransparency = fadeProgress
                for _, child in pairs(screenGui:GetChildren()) do
                    if child:IsA("TextLabel") then
                        child.TextTransparency = fadeProgress
                    elseif child:IsA("ImageLabel") then
                        child.ImageTransparency = fadeProgress
                    end
                end
            end)
            return
        end
    end)
end

-- Chạy Intro
local screenGui, loadingCircle, percentLabel, loadingText = createIntro()
animateIntro(screenGui, loadingCircle, percentLabel, loadingText)


-- // Hàm lấy danh sách server
local function GetServers(placeId, cursor)
    local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. cursor
    end
    local success, result = pcall(function()
        return game:HttpGet(url)
    end)
    if not success then return nil end
    return game:GetService("HttpService"):JSONDecode(result)
end

-- // Hàm Hop Server
local function HopToServer(serverId)
    if serverId then
        game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, serverId, LP)
    end
end

-- // Hàm Hop Random
local function HopToRandomServer()
    local placeId = game.PlaceId
    local data = GetServers(placeId, "")
    if not data then return end
    
    local availableServers = {}
    for _, server in ipairs(data.data) do
        if server.playing < server.maxPlayers then
            table.insert(availableServers, server.id)
        end
    end
    
    if #availableServers > 0 then
        local randomId = availableServers[math.random(1, #availableServers)]
        HopToServer(randomId)
    end
end

-- // Hàm kiểm tra boss trong server
local function CheckCurrentServerBoss(bossName)
    local enemies = game:GetService("Workspace").Enemies
    local replicated = game:GetService("ReplicatedStorage")
    
    for _, enemy in ipairs(enemies:GetChildren()) do
        if enemy.Name:find(bossName) or enemy.Name == bossName then
            return true
        end
    end
    
    for _, enemy in ipairs(replicated:GetChildren()) do
        if enemy.Name:find(bossName) or enemy.Name == bossName then
            return true
        end
    end
    
    return false
end

-- // Hàm tìm server có boss
local function FindServerWithBoss(bossName, callback)
    local placeId = game.PlaceId
    local cursor = ""
    local found = false
    
    task.spawn(function()
        while not found do
            local data = GetServers(placeId, cursor)
            if not data then break end
            
            for _, server in ipairs(data.data) do
                if server.playing < server.maxPlayers then
                    local serverId = server.id
                    local success, hasBoss = pcall(function()
                        local info = game:GetService("HttpService"):JSONDecode(
                            game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/" .. serverId)
                        )
                        return info and info.playing > 0
                    end)
                    
                    if success and hasBoss then
                        found = true
                        callback(serverId)
                        break
                    end
                end
            end
            
            if data.nextPageCursor and data.nextPageCursor ~= "null" then
                cursor = data.nextPageCursor
            else
                break
            end
            task.wait(0.5)
        end
    end)
end


task.spawn(function()
    while true do
        pcall(function()
            if getgenv().AutoFarm or getgenv().AutoMaterial or getgenv().MasteryFarm then
                local weaponType = getgenv().SelectWeapon or "Melee"
                local backpack = LP.Backpack
                local character = LP.Character

                for _, tool in ipairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") and tool.ToolTip == weaponType then
                        if not character:FindFirstChild(tool.Name) then
                            character.Humanoid:EquipTool(tool)
                        end
                        break
                    end
                end
            end
        end)
        task.wait(0.5)
    end
end)


local function UpdatePlayerInfo()
    local player = LP
    if player and player.Data then
        local level = player.Data.Level.Value or 0
        local beli = player.Data.Beli.Value or 0
        local fragments = player.Data.Fragments and player.Data.Fragments.Value or 0
        local race = player.Data.Race.Value or "Unknown"
        local fruit = player.Data.DevilFruit.Value or "None"

        PlayerInfo:SetDesc(string.format(
            "Level: %d | Beli: %s | Fragments: %s\nRace: %s | Fruit: %s",
            level,
            tostring(beli):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""),
            tostring(fragments):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""),
            race,
            fruit
        ))
    end
end

task.spawn(function()
    while true do
        pcall(UpdatePlayerInfo)
        task.wait(2)
    end
end)


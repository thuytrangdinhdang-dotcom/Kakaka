-- //==================== UTILITY FUNCTIONS ====================//
function StopTween()
    pcall(function()
        if tween then
            tween:Cancel()
            tween = nil
        end

        local char = LP.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Anchored = true
                task.wait(0.1)
                root.Anchored = false
            end
        end

        getgenv().StopTween = false
        getgenv().Clip = false
        getgenv().StartMagnet = false
    end)
end

function topos(cframe)
    pcall(function()
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then
            return
        end

        local root = LP.Character.HumanoidRootPart
        local distance = (cframe.Position - root.Position).Magnitude

        if distance <= 10 then
            root.CFrame = cframe
            return
        end

        local tweenSpeed = getgenv().TweenSpeed or 350

        local tweenInfo = TweenInfo.new(
            distance / tweenSpeed,
            Enum.EasingStyle.Linear
        )

        tween = TweenService:Create(root, tweenInfo, { CFrame = cframe })
        tween:Play()
        tween.Completed:Wait()

        root.CFrame = cframe
    end)
end

function AutoHaki()
    pcall(function()
        if getgenv().AUTOHAKI and not LP.Character:FindFirstChild("HasBuso") then
            ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
        end
    end)
end

function EquipWeapon(weaponName)
    pcall(function()
        if not weaponName then return end

        local char = LP.Character
        local backpack = LP.Backpack

        if char:FindFirstChild(weaponName) then
            return
        end

        local tool = backpack:FindFirstChild(weaponName)
        if tool then
            char.Humanoid:EquipTool(tool)
        end
    end)
end

function UnEquipWeapon(weaponName)
    pcall(function()
        local char = LP.Character
        local tool = char:FindFirstChild(weaponName)
        if tool then
            tool.Parent = LP.Backpack
        end
    end)
end
